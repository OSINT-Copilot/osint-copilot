# Plugin settings, written into whatever directory is opened as a vault. Ends up in
# the repo whenever the app is launched with the checkout itself as the workspace.
.osint-copilot/
# The same accident's other traces, when apps/tangent-electron itself is opened as the
# workspace: the OSINT layer's defaults and Tangent's index. Path-specific, because
# vaults legitimately contain an OSINTCopilot/ folder, and test workspaces a .tangent/.
/apps/tangent-electron/OSINTCopilot/
/apps/tangent-electron/.tangent/

# Licence signing key. NEVER commit: anyone holding it can mint valid licence keys.
.license-signing-key.pem
*.license-signing-key.pem

# Playwright failure artifacts (screenshots, traces, error context).
# Only ever appear when the e2e suite actually runs, which on Linux it now can.
test-results/
