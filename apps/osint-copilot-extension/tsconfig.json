{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["chrome"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
