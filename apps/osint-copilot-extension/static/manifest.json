{
	"manifest_version": 3,
	"name": "OSINT Copilot extension",
	"short_name": "OSINT Copilot",
	"version": "0.1.0",
	"description": "Send notes and entities from web pages into an OSINT Copilot investigation on this computer.",
	"minimum_chrome_version": "140",
	"key": "",
	"background": {
		"service_worker": "sw.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"action": {
		"default_title": "Open OSINT Copilot",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"],
	"optional_permissions": ["pageCapture"],
	"host_permissions": ["http://127.0.0.1/*"],
	"optional_host_permissions": ["<all_urls>"],
	"commands": {
		"capture-page": {
			"suggested_key": {
				"default": "Ctrl+Shift+Y",
				"mac": "Command+Shift+Y"
			},
			"description": "Capture this page to OSINT Copilot"
		}
	}
}
