{
	"name": "osint-copilot-extension",
	"version": "0.1.0",
	"private": true,
	"description": "OSINT Copilot extension: send notes, entities and page captures from the browser into an OSINT Copilot investigation.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.0",
		"esbuild": "0.27.2",
		"fake-indexeddb": "^6.2.5"
	}
}
