{
	"name": "osint-copilot-extension",
	"version": "0.1.1",
	"private": true,
	"description": "OSINT Copilot extension: send notes, entities, page captures and highlights from the browser into an OSINT Copilot investigation.",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22.2"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run",
		"e2e": "node build.mjs && playwright test -c playwright.config.ts",
		"zip": "node scripts/zip.mjs"
	},
	"dependencies": {
		"approx-string-match": "2.0.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/chrome": "^0.3.5",
		"@types/node": "^26.6.5",
		"esbuild": "0.28.2",
		"fake-indexeddb": "^6.2.6",
		"jsdom": "^24.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	}
}
