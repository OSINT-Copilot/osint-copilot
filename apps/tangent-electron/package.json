{
  "name": "osint-copilot",
  "productName": "OSINT Copilot",
  "version": "0.14.7",
  "private": true,
  "description": "An OSINT investigation workspace built on local markdown notes.",
  "repository": "https://github.com/OSINT-Copilot/osint-copilot",
  "license": "Apache-2.0",
  "main": "__build/bundle/main.js",
  "scripts": {
    "dev": "NODE_ENV=development node dev.js",
    "dev:debug": "DEBUG=5858 NODE_ENV=development node dev.js",
    "dev:prod": "node dev.js",
    "dev:win": "SET \"NODE_ENV=development\" && node dev.js",
    "start": "node scripts/launch.mjs",
    "app": "npm run build && npm run start",
    "build": "node build/index.js",
    "generate:icons": "node build/generate-icons.mjs",
    "typecheck:osint": "tsc --noEmit -p src/osint/tsconfig.json && tsc --noEmit -p src/osint/tests/tsconfig.json && tsc --noEmit -p src/osint/tests/tsconfig.tangent.json",
    "build:dev": "NODE_ENV=development NO_WATCH=true npm run build",
    "clean": "rm -rf dist ; rm -rf __build",
    "clean-build": "npm run clean && npm run build",
    "release": "electron-builder",
    "package:test": "electron-builder --publish never --dir -c.mac.identity=null",
    "release:test-notarize": "NOTARIZE=force electron-builder --publish never",
    "publish:mac": "electron-builder --mac --publish always",
    "package:mac": "electron-builder --mac --publish never",
    "publish:win": "electron-builder --win --publish always",
    "package:win": "electron-builder --win --publish never",
    "package:win:x64": "electron-builder --win --x64 --publish never",
    "publish:linux": "electron-builder --linux --publish always",
    "package:linux": "electron-builder --linux --publish never",
    "publish:all": "electron-builder -mwl --publish always",
    "package:all": "electron-builder -mwl --publish never",
    "build-and-release:all": "npm run clean-build && npm run test:no-build && npm run publish:all",
    "test": "vitest run && npm run build:dev && npm run test:end-to-end",
    "test:no-build": "vitest run && npm run test:end-to-end",
    "test:unit": "vitest run --project tangent-electron-unit-core --project tangent-electron-unit-web",
    "test:integration": "vitest run --project tangent-electron-integration",
    "test:end-to-end": "playwright test --project Tests",
    "demo": "playwright test --project Demo",
    "svelte-dev": "webpack watch"
  },
  "keywords": [],
  "author": "Probe Point Analytics LLC",
  "dependencies": {
    "@such-n-such/tangent-query-parser": "^0.1.0",
    "@typewriter/delta": "^1.0.2",
    "@typewriter/document": "file:../../lib/typewriter-document",
    "adm-zip": "^0.6.1",
    "chalk": "^5.4.1",
    "cheerio": "^1.2.0",
    "cytoscape": "3.28.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^16.5.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.8.9",
    "fast-equals": "^5.2.2",
    "font-list": "^1.4.0",
    "js-logger": "^1.6.1",
    "leaflet": "1.9.4",
    "link-preview-js": "^5.0.1",
    "lucide-static": "^1.39.0",
    "markdown-it": "^15.0.3",
    "media-chrome": "^4.12.0",
    "node-fetch": "^3.3.0",
    "pmtiles": "^4.5.0",
    "prismjs": "^1.24.1",
    "protomaps-leaflet": "^5.1.0",
    "semver": "^7.3.7",
    "source-map-support": "^0.5.19",
    "svelte": "^5.57.2",
    "turndown": "^7.2.2",
    "typewriter-editor": "file:../../lib/typewriter",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "^9.2.0",
    "watcher": "^2.3.1",
    "yaml": "^2.9.1",
    "yargs": "^17.1.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@floating-ui/dom": "^1.6.13",
    "@napi-rs/canvas": "^0.1.88",
    "@playwright/test": "^1.61.0",
    "@popperjs/core": "^2.9.2",
    "@such-n-such/core": "^0.5.0",
    "@such-n-such/tangent-html-to-markdown": "^0.1.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.15.21",
    "@types/prismjs": "^1.16.6",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "date-fns": "^4.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.3.0",
    "electronmon": "^2.0.4",
    "html-tag-names": "^2.1.0",
    "jsdom": "^28.1.0",
    "katex": "^0.16.8",
    "language-name-map": "^0.3.0",
    "lorem-ipsum": "^2.0.8",
    "mermaid": "^11.11.0",
    "mini-css-extract-plugin": "^2.9.2",
    "pdfjs-dist": "^5.4.54",
    "playwright": "^1.61.0",
    "prism-svelte": "^0.5.0",
    "sass": "^1.32.10",
    "sass-loader": "^16.0.5",
    "svelte-dnd-action": "^0.9.14",
    "svelte-loader": "^3.1.8",
    "svelte-preprocess": "^6.0.3",
    "svg-tag-names": "^3.0.1",
    "ts-loader": "^9.4.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.0.0",
    "uuid": "^11.1.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "webpack": "^5.16.0",
    "webpack-cli": "^6.0.1"
  }
}
