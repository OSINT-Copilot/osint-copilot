{
	"appId": "com.probepoint.osint-copilot",
	"productName": "OSINT Copilot",
	"copyright": "Copyright © 2026 Probe Point Analytics LLC. Based on Tangent, © Taylor Hadden.",

	"generateUpdatesFilesForAllChannels": true,
	"electronVersion": "42.1.0",

	"files": [
		"node_modules/**/*",
		"static/**/*",
		"package.json",
		"defaults/**/*",
		{
			"from": "__build",
			"to": "__build",
			"filter": ["**/*",
				"!bundle/app.css", "!bundle/app.css.map"
			]
		},
		{
			"from": "__build/bundle",
			"to": "static",
			"filter": ["*.css", "*.css.map"]
		}
	],

	"mac": {
		"category": "public.app-category.productivity",
		"hardenedRuntime": true,
		"entitlements": "build/entitlements.mac.plist",
		"entitlementsInherit": "build/entitlements.mac.plist",
		"target": {
			"target": "default",
			"arch": "universal"
		},
		"icon": "build/Icon.icon",
		"notarize": false,
		"extendInfo": {
			"CFBundleDocumentTypes": [
				{
					"LSItemContentTypes": ["public.folder", "public.directory"],
					"CFBundleTypeRole": "Editor",
					"LSHandlerRank": "Alternate"
				},
				{
					"LSItemContentTypes": ["public.plain-text"],
					"CFBundleTypeRole": "Editor",
					"LSHandlerRank": "Default"
				},
				{
					"LSItemContentTypes": [
						"public.jpeg",
						"public.tiff",
						"public.png",
						"com.compuserve.gif",
						"com.microsoft.bmp",
						"public.svg"
					],
					"CFBundleTypeRole": "Viewer",
					"LSHandlerRank": "Alternate"
				}
			]
		}
	},

	"win": {
		"target": [
			{
				"target": "nsis",
				"arch": ["x64", "arm64"]
			},
			{
				"target": "portable",
				"arch": ["x64", "arm64"]
			}
		],
		"signtoolOptions": {
			"sign": "./build/jsign.js"
		},
		"fileAssociations": [
			{
				"ext": ["md", "mdx"],
				"description": "Markdown Files",
				"role": "Editor",
				"rank": "Alternate"
			},
			{
				"ext": ["jpg", "jpeg", "png", "PNG", "gif", "bmp", "svg"],
				"description": "Images Files",
				"role": "Viewer"
			}
		]
	},

	"nsis": {
		"artifactName": "${productName}-Setup-${version}.${ext}",
		"oneClick": false,
		"allowElevation": true,
		"allowToChangeInstallationDirectory": true
	},

	"portable": {
		"artifactName": "${productName}-Portable-${version}.${ext}"
	},

	"linux": {
		"category": "Office",
		"maintainer": "Probe Point Analytics LLC",
		"synopsis": "OSINT investigation workspace",
		// X11 through XWayland. Under a Wayland session the app initialises and then crashes
		// in the compositor, and the platform cannot be chosen from JS -- Chromium fixes it
		// before the main script runs, so app.commandLine.appendSwitch is too late even as the
		// first statement. The desktop entry is the earliest place it can be set. %U is
		// repeated here because electron-builder only appends it when executableArgs carries
		// no exec code.
		//
		// A real comment, not a "__comment_" key: electron-builder validates this object
		// against a schema that rejects unknown properties, so the key form failed the whole
		// build. It parses this file with JSON5 (app-builder-lib/out/util/config/load.js:22),
		// which allows comments -- but Node's require() does not, so nothing may require it.
		"executableArgs": ["--ozone-platform=x11", "%U"],
		"target": [
			{
				"target": "AppImage",
				"arch": ["x64", "arm64"]
			},
			{
				"target": "deb",
				"arch": ["x64"]
			}
		],
		"fileAssociations": [
			{
				"ext": "md",
				"mimeType": "text/plain"
			},
			{
				"ext": "mdx",
				"mimeType": "text/plain"
			},
			{
				"ext": "jpg",
				"mimeType": "image/jpeg"
			},
			{
				"ext": "jpeg",
				"mimeType": "image/jpeg"
			},
			{
				"ext": "png",
				"mimeType": "image/png"
			},
			{
				"ext": "gif",
				"mimeType": "image/gif"
			},
			{
				"ext": "bmp",
				"mimeType": "image/bmp"
			}
		]
	},

	"publish": [
		{
			"provider": "github",
			"owner": "Probe-Point-Analytics-LLC",
			"repo": "osint-copilot",
			"releaseType": "draft"
		}
	],

	"afterSign": "build/notarize.js"
}
